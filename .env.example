# LUNATIC MOBILE SECURITY - configuration example.
# Copy to ".env" at the project root and adjust. Every value is optional.

# Loopback address only (127.0.0.1, ::1 or localhost). Other values are refused.
LMS_HOST=127.0.0.1
LMS_PORT=8765

# Per-user data directory (logs, downloads, backups). Default:
#   Linux   ~/.local/share/lunatic-mobile-security
#   macOS   ~/Library/Application Support/LunaticMobileSecurity
#   Windows %LOCALAPPDATA%\LunaticMobileSecurity
# LMS_DATA_DIR=

# Directory containing adb and fastboot (official Android SDK Platform-Tools).
# Default lookup: this directory, then <data dir>/platform-tools, then PATH.
# LMS_PLATFORM_TOOLS_DIR=/home/me/platform-tools

# DEBUG, INFO, WARN, ERROR, CRITICAL
LMS_LOG_LEVEL=INFO

# Timeouts in seconds
LMS_COMMAND_TIMEOUT=30
LMS_FLASH_TIMEOUT=900

# Open the interface in the default browser at startup
LMS_OPEN_BROWSER=true

# Official GrapheneOS release endpoint (HTTPS, official hosts only)
LMS_GRAPHENEOS_RELEASES_URL=https://releases.grapheneos.org
